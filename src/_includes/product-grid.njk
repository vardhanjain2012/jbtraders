{#-
  Tab strip and product panels for one category, driven by _data/categories.json
  and _data/products.json. The page supplies `navActive`; every card on the page
  comes from the data file, whether or not the item has its own detail page.

  Per-tab buttons only appear when a category has more than one tab — with a
  single panel there is nothing to filter between.
-#}
{%- set cat = categories[navActive] %}
        <div class="overflow-x-auto md:overflow-visible md:w-52 flex-shrink-0">
            <div role="tablist" aria-label="{{ cat.ariaLabel }}" aria-orientation="vertical"
                class="flex md:flex-col gap-2 w-max md:w-full pb-1 md:pb-0 md:sticky md:top-24">
                <button type="button" role="tab" data-tab="all" aria-selected="true"
                    class="tab-btn whitespace-nowrap md:whitespace-normal md:w-full md:text-left px-4 py-2 rounded-full md:rounded-lg text-sm font-semibold bg-blue-800 text-white">All</button>
{%- if cat.tabs.length > 1 %}
{%- for tab in cat.tabs %}
                <button type="button" role="tab" data-tab="{{ tab.key }}" aria-selected="false"
                    id="tab-{{ tab.key }}" aria-controls="panel-{{ tab.key }}"
                    class="tab-btn whitespace-nowrap md:whitespace-normal md:w-full md:text-left px-4 py-2 rounded-full md:rounded-lg text-sm font-semibold bg-gray-100 text-gray-700 hover:bg-gray-200">{{ tab.buttonLabel | default(tab.label) }}</button>
{%- endfor %}
{%- endif %}
            </div>
        </div>

        <div class="flex-1 space-y-12">
{%- for tab in cat.tabs %}

        <div id="panel-{{ tab.key }}" data-panel="{{ tab.key }}" role="tabpanel"{% if cat.tabs.length > 1 %} aria-labelledby="tab-{{ tab.key }}"{% endif %}>
            <h2{% if tab.anchorId %} id="{{ tab.anchorId }}"{% endif %} class="text-2xl font-bold text-blue-900 mb-3{% if tab.anchorId %} scroll-mt-24{% endif %}">{{ tab.label }}</h2>
{%- if tab.note %}
            <p class="text-gray-700 mb-6">{{ tab.note }}</p>
{%- endif %}
{%- if tab.comment %}
            <!-- {{ tab.comment }} -->
{%- endif %}
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
{%- for item in products %}
{%- if item.category == navActive and item.tab == tab.key %}
{%- set c = item | merge(item.card) %}

                <article class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden flex flex-col">
                    <img src="images/products/{{ c.image }}" alt="{{ c.alt }}" loading="lazy"
                        width="400" height="400" class="w-full aspect-square object-cover bg-gray-100">
                    <div class="p-4 flex flex-col flex-1">
                        <h3 class="text-base font-bold text-blue-900">{{ c.name }}</h3>
                        <p class="text-xs font-semibold text-gray-500 mb-3">{{ c.subtitle }}</p>
                        <div class="mt-auto flex flex-col gap-2">
{%- if item.hasPage %}
                            <a href="products/{{ item.slug }}.html"
                                class="text-sm font-semibold text-blue-700 hover:underline">View details &rarr;</a>
{%- elif item.showCall %}
                            <a href="tel:{{ site.phone }}"
                                class="flex items-center justify-center gap-2 bg-blue-700 hover:bg-blue-600 text-white px-3 py-2 rounded-lg transition font-semibold text-sm">
                                📞 Call for Availability</a>
{%- endif %}
                            <a href="https://wa.me/{{ site.whatsapp }}?text={{ ('Hi, I want to enquire about ' + c.enquiryName) | urlencode }}"
                                target="_blank"
                                class="flex items-center justify-center gap-2 bg-green-700 hover:bg-green-800 text-white px-3 py-2 rounded-lg transition font-semibold text-sm">
                                💬 Enquire</a>
                        </div>
                    </div>
                </article>
{%- endif %}
{%- endfor %}

            </div>
        </div>
{%- endfor %}
