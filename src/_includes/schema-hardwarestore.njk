    <!-- TODO: add "image" (absolute URL to a real shopfront photo) once available -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "HardwareStore",
      "name": "{{ site.name }}",
      "url": "{{ site.url }}/",
      "telephone": "{{ site.phone }}",
      "foundingDate": "{{ site.foundingDate }}",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "{{ site.street }}",
        "addressLocality": "{{ site.city }}",
        "addressRegion": "{{ site.state }}",
        "postalCode": "{{ site.postalCode }}",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 22.691302437740323,
        "longitude": 75.84403369685747
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
          "opens": "09:00",
          "closes": "19:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Sunday"],
          "opens": "09:00",
          "closes": "13:00"
        }
      ],
      "areaServed": [
        { "@type": "City", "name": "Indore" },
        { "@type": "City", "name": "Dewas" },
        { "@type": "City", "name": "Sanwer" },
        { "@type": "City", "name": "Rau" },
        { "@type": "City", "name": "Pithampur" },
        { "@type": "City", "name": "Mhow" }
      ],
      "priceRange": "₹₹",
      "currenciesAccepted": "INR",
      "paymentAccepted": "Cash, UPI, Net Banking",
      "knowsLanguage": ["hi", "en"]
    }
    </script>
