---
pagination:
  data: productPages
  size: 1
  alias: product
permalink: "products/{{ product.slug }}.html"
layout: base.njk
eleventyComputed:
  title: "{{ product.title }}"
  description: "{{ product.description }}"
  navActive: "{{ product.category }}"
---

    <div class="max-w-4xl mx-auto px-4 pt-6">
        <a href="/{{ product.category }}.html{% if product.backAnchor %}#{{ product.backAnchor }}{% endif %}"
            class="inline-flex items-center gap-1 text-sm font-semibold text-blue-700 hover:text-blue-800 hover:underline">
            &larr; Back to {{ categories[product.category].label }}
        </a>
    </div>

    <div class="max-w-4xl mx-auto px-4 pt-2 text-sm text-gray-500">
        <a href="/" class="hover:underline hover:text-blue-700">Home</a>
        <span class="mx-1">&rsaquo;</span>
        <a href="/{{ product.category }}.html" class="hover:underline hover:text-blue-700">{{ categories[product.category].label }}</a>
        <span class="mx-1">&rsaquo;</span>
        <span class="text-gray-700">{{ product.name }}</span>
    </div>

    <section class="py-8 max-w-4xl mx-auto px-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 items-start bg-white p-6 sm:p-8 rounded-xl shadow-sm border border-gray-200">
            <img src="/images/products/{{ product.image }}" alt="{{ product.alt }}" loading="lazy" width="400"
                height="400" class="w-full aspect-square object-cover bg-gray-100 rounded-lg">
            <div class="flex flex-col">
                <h1 class="text-3xl font-extrabold text-gray-900 mb-1">{{ product.name }}</h1>
                <p class="text-sm font-semibold text-gray-500 mb-6">{{ product.subtitle }}</p>
                <div class="flex flex-col gap-3">
                    <a href="tel:{{ site.phone }}"
                        class="flex items-center justify-center gap-2 bg-blue-700 hover:bg-blue-600 text-white px-6 py-3 rounded-lg transition font-semibold">
                        📞 Call for Availability
                    </a>
                    <a href="https://wa.me/{{ site.whatsapp }}?text={{ ('Hi, I want to enquire about ' + product.enquiryName) | urlencode }}" target="_blank"
                        class="flex items-center justify-center gap-2 bg-green-500 hover:bg-green-400 text-white px-6 py-3 rounded-lg transition font-semibold">
                        💬 Enquire on WhatsApp
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="pb-8 max-w-4xl mx-auto px-4">
        <div class="bg-white p-6 sm:p-8 rounded-xl shadow-sm border border-gray-200 text-gray-700 space-y-4">
{%- for para in product.paragraphs %}
            <p>{{ para }}</p>
{%- endfor %}
        </div>
    </section>
{%- if product.related.length %}

    <section class="pb-12 max-w-4xl mx-auto px-4">
        <h2 class="text-xl font-bold text-blue-900 mb-4">Related Products</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
{%- for entry in product.related %}
{%- set r = ((products | bySlug(entry.slug)) | merge(entry)) if entry.slug else entry %}
{%- set href = ("/products/" + r.slug + ".html") if entry.slug else entry.href %}
            <a href="{{ href }}"
                class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden flex flex-col hover:shadow-md hover:border-blue-200 transition">
                <img src="/images/products/{{ r.image }}" alt="{{ r.alt }}" loading="lazy" width="400"
                    height="400" class="w-full aspect-square object-cover bg-gray-100">
                <div class="p-3">
                    <h3 class="text-sm font-bold text-blue-900">{{ r.name }}</h3>
                    <p class="text-xs text-gray-500">{{ r.subtitle }}</p>
                </div>
            </a>
{%- endfor %}
        </div>
    </section>
{%- endif %}
